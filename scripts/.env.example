APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_PRODUCT_IMAGES=product-images

# --- Local tooling only: NOT read by the Next.js app or the migration script above.
# Used only when Claude Code needs to act on your behalf against Supabase/GitHub
# from this machine (e.g. updating Auth settings, checking CI status). Same
# gitignore rule as the rest of this file: never commit real values.

# Personal access token, scoped to your account (all projects). Generate at
# https://supabase.com/dashboard/account/tokens. Lets the Supabase CLI/Management
# API act on your projects (e.g. `supabase link`, `supabase config push`,
# PATCH /v1/projects/{ref}/config/auth) without an interactive browser login.
SUPABASE_ACCESS_TOKEN=
# This project's ref (Project Settings -> General -> Reference ID), so commands
# don't need `supabase link` run interactively first.
SUPABASE_PROJECT_REF=

# GitHub personal access token (classic or fine-grained, `repo` + `workflow` read
# scope is enough). Generate at https://github.com/settings/tokens. Picked up
# automatically by `gh` as GH_TOKEN, so `gh auth login` (interactive) isn't needed.
GH_TOKEN=
